{
  "id": "ra-f08",
  "adapter": "remoteassist",
  "purpose": "진단 전용 동의·등록 Runbook 미리보기/승인/거절/취소·관리자형 실행 | 화면 0인 진단, 승인 hash와 실행 일치, 결과·감사·timeout 정리",
  "coverage": [
    "V33",
    "V34",
    "F08"
  ],
  "preconditions": [
    "two-pc",
    "registered-runbook",
    "D21 deployment and D22 recovery proof",
    "candidate fixed; telemetry fresh",
    "all per-condition fixtures reviewed separately; common round never accepts whole F"
  ],
  "evidence": [
    "spec-f08-all-subconditions",
    "matching-candidate-and-environment",
    "independent-observation-and-cleanup"
  ],
  "stopCondition": "first failure or missing readiness ends round; no retry or edit",
  "cleanup": "release browser keys; stop both nodes; verify owned cleanup and normal desktop; retain dirty reservations",
  "reuse": "matching-candidate contracts and fixtures once; unexecuted subconditions remain NOT RUN",
  "targetSeconds": 600,
  "maximumSeconds": 900,
  "screenSeconds": 300,
  "recovery": "R1",
  "steps": [
    {
      "id": "start",
      "role": "host",
      "action": "host-start",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "join",
      "role": "viewer",
      "action": "viewer-join",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "consent",
      "role": "host",
      "action": "consent",
      "arguments": {
        "monitor": "REPLACE_WITH_PREPARED_MONITOR",
        "permissions": "screen",
        "decision": "approve"
      },
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "video",
      "role": "viewer",
      "action": "observe-video",
      "arguments": {},
      "assertions": [
        {
          "fact": "decoded-delta",
          "relation": "ge",
          "expected": "1",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "marker-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "monitor-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "end",
      "role": "host",
      "action": "target-end",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "audit",
      "role": "host",
      "action": "observe-audit",
      "arguments": {
        "kind": "3",
        "result": "2"
      },
      "assertions": [
        {
          "fact": "audit-matches",
          "relation": "ge",
          "expected": "1",
          "source": "product-audit",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    }
  ]
}
