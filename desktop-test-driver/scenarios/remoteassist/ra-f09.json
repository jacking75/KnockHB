{
  "id": "ra-f09",
  "adapter": "remoteassist",
  "purpose": "서비스/Tray/헬퍼/서버 종료, blackhole, 로그오프/사용자 전환·RDP 공존, 반복 접속 | fail-closed, 잔여 프로세스/세션/키 없음, 무동의 자동 재개 없음",
  "coverage": [
    "V08",
    "V09",
    "V14",
    "V38",
    "F09"
  ],
  "preconditions": [
    "two-pc",
    "service-failure",
    "D21 deployment and D22 recovery proof",
    "candidate fixed; telemetry fresh",
    "all per-condition fixtures reviewed separately; common round never accepts whole F"
  ],
  "evidence": [
    "spec-f09-all-subconditions",
    "matching-candidate-and-environment",
    "independent-observation-and-cleanup"
  ],
  "stopCondition": "first failure or missing readiness ends round; no retry or edit",
  "cleanup": "release browser keys; stop both nodes; verify owned cleanup and normal desktop; retain dirty reservations",
  "reuse": "matching-candidate contracts and fixtures once; unexecuted subconditions remain NOT RUN",
  "targetSeconds": 600,
  "maximumSeconds": 900,
  "screenSeconds": 300,
  "recovery": "R1",
  "steps": [
    {
      "id": "start",
      "role": "host",
      "action": "host-start",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "join",
      "role": "viewer",
      "action": "viewer-join",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "consent",
      "role": "host",
      "action": "consent",
      "arguments": {
        "monitor": "REPLACE_WITH_PREPARED_MONITOR",
        "permissions": "screen",
        "decision": "approve"
      },
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "video",
      "role": "viewer",
      "action": "observe-video",
      "arguments": {},
      "assertions": [
        {
          "fact": "decoded-delta",
          "relation": "ge",
          "expected": "1",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "marker-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "monitor-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
