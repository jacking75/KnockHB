{
  "id": "ra-f06",
  "adapter": "remoteassist",
  "purpose": "양방향 파일·채팅·텍스트 클립보드, 수락/거절/중단 | hash 일치, 경로 탈출·무단 읽기/덮어쓰기 없음, clipboard loop 없음",
  "coverage": [
    "V31",
    "V32",
    "F06"
  ],
  "preconditions": [
    "two-pc",
    "file-sandbox",
    "clipboard-fixture",
    "D21 deployment and D22 recovery proof",
    "candidate fixed; telemetry fresh",
    "all per-condition fixtures reviewed separately; common round never accepts whole F"
  ],
  "evidence": [
    "spec-f06-all-subconditions",
    "matching-candidate-and-environment",
    "independent-observation-and-cleanup"
  ],
  "stopCondition": "first failure or missing readiness ends round; no retry or edit",
  "cleanup": "release browser keys; stop both nodes; verify owned cleanup and normal desktop; retain dirty reservations",
  "reuse": "matching-candidate contracts and fixtures once; unexecuted subconditions remain NOT RUN",
  "targetSeconds": 600,
  "maximumSeconds": 900,
  "screenSeconds": 300,
  "recovery": "R1",
  "steps": [
    {
      "id": "start",
      "role": "host",
      "action": "host-start",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "join",
      "role": "viewer",
      "action": "viewer-join",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "consent",
      "role": "host",
      "action": "consent",
      "arguments": {
        "monitor": "REPLACE_WITH_PREPARED_MONITOR",
        "permissions": "screen",
        "decision": "approve"
      },
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "file",
      "role": "host",
      "action": "observe-file",
      "arguments": {},
      "assertions": [
        {
          "fact": "file-hash-matches",
          "relation": "eq",
          "expected": "true",
          "source": "received-file",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "chat",
      "role": "viewer",
      "action": "observe-chat",
      "arguments": {},
      "assertions": [
        {
          "fact": "chat-count",
          "relation": "eq",
          "expected": "1",
          "source": "viewer-chat",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "end",
      "role": "host",
      "action": "target-end",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "audit",
      "role": "host",
      "action": "observe-audit",
      "arguments": {
        "kind": "3",
        "result": "2"
      },
      "assertions": [
        {
          "fact": "audit-matches",
          "relation": "ge",
          "expected": "1",
          "source": "product-audit",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    }
  ]
}
