{
  "id": "ra-f12",
  "adapter": "remoteassist",
  "purpose": "이전 설치본 → 서명 업데이트 → 실패 rollback → 재시작 → 제거 | 변조 거부, 정상 버전 복구, 활성 세션 보호, 새 동의 요구, 잔여 구성 정리",
  "coverage": [
    "V37",
    "V41",
    "F12"
  ],
  "preconditions": [
    "two-pc",
    "install-update-rollback",
    "D21 deployment and D22 recovery proof",
    "candidate fixed; telemetry fresh",
    "all per-condition fixtures reviewed separately; common round never accepts whole F"
  ],
  "evidence": [
    "spec-f12-all-subconditions",
    "matching-candidate-and-environment",
    "independent-observation-and-cleanup"
  ],
  "stopCondition": "first failure or missing readiness ends round; no retry or edit",
  "cleanup": "release browser keys; stop both nodes; verify owned cleanup and normal desktop; retain dirty reservations",
  "reuse": "matching-candidate contracts and fixtures once; unexecuted subconditions remain NOT RUN",
  "targetSeconds": 600,
  "maximumSeconds": 900,
  "screenSeconds": 300,
  "recovery": "R2",
  "steps": [
    {
      "id": "start",
      "role": "host",
      "action": "host-start",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "join",
      "role": "viewer",
      "action": "viewer-join",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "consent",
      "role": "host",
      "action": "consent",
      "arguments": {
        "monitor": "REPLACE_WITH_PREPARED_MONITOR",
        "permissions": "screen",
        "decision": "approve"
      },
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "video",
      "role": "viewer",
      "action": "observe-video",
      "arguments": {},
      "assertions": [
        {
          "fact": "decoded-delta",
          "relation": "ge",
          "expected": "1",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "marker-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "monitor-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "end",
      "role": "host",
      "action": "target-end",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "audit",
      "role": "host",
      "action": "observe-audit",
      "arguments": {
        "kind": "3",
        "result": "2"
      },
      "assertions": [
        {
          "fact": "audit-matches",
          "relation": "ge",
          "expected": "1",
          "source": "product-audit",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    }
  ]
}
