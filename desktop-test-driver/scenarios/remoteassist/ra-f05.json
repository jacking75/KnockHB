      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "audit",
      "role": "host",
