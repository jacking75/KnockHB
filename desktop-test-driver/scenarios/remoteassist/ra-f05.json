{
  "id": "ra-f05",
  "adapter": "remoteassist",
  "purpose": "별도 관리자 승인 → 승격 앱·UAC·SAS·잠금·복귀 → 관리자 해제 | 미승인 접근 0, 보안 데스크톱 중단 수단, 잘못된 세션 접근 없음",
  "coverage": [
    "V05",
    "V25",
    "V26",
    "F05"
  ],
  "preconditions": [
    "two-pc",
    "secure-desktop",
    "independent-console",
    "D21 deployment and D22 recovery proof",
    "candidate fixed; telemetry fresh",
    "all per-condition fixtures reviewed separately; common round never accepts whole F"
  ],
  "evidence": [
    "spec-f05-all-subconditions",
    "matching-candidate-and-environment",
    "independent-observation-and-cleanup"
  ],
  "stopCondition": "first failure or missing readiness ends round; no retry or edit",
  "cleanup": "release browser keys; stop both nodes; verify owned cleanup and normal desktop; retain dirty reservations",
  "reuse": "matching-candidate contracts and fixtures once; unexecuted subconditions remain NOT RUN",
  "targetSeconds": 600,
  "maximumSeconds": 900,
  "screenSeconds": 300,
  "recovery": "R2",
  "steps": [
    {
      "id": "start",
      "role": "host",
      "action": "host-start",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "join",
      "role": "viewer",
      "action": "viewer-join",
      "arguments": {},
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "viewer"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "consent",
      "role": "host",
      "action": "consent",
      "arguments": {
        "monitor": "REPLACE_WITH_PREPARED_MONITOR",
        "permissions": "screen",
        "decision": "approve"
      },
      "assertions": [
        {
          "fact": "action-receipt",
          "relation": "eq",
          "expected": "true",
          "source": "driver-local",
          "role": "host"
        }
      ],
      "timeoutMilliseconds": 3000
    },
    {
      "id": "video",
      "role": "viewer",
      "action": "observe-video",
      "arguments": {},
      "assertions": [
        {
          "fact": "decoded-delta",
          "relation": "ge",
          "expected": "1",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "marker-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        },
        {
          "fact": "monitor-matches",
          "relation": "eq",
          "expected": "true",
          "source": "browser-decoder",
          "role": "viewer"
        }
