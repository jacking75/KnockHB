<Project Sdk="Microsoft.NET.Sdk">

  <!--
    로그인한 사용자 세션에서 도는 트레이 UI(일반 권한).
    동의 대화상자·세션 코드/PIN 표시·접속 중 배지·즉시 종료를 맡고,
    서비스와는 Named Pipe IPC로만 통신한다.
  -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAssist.Protocol\RemoteAssist.Protocol.csproj" />
  </ItemGroup>

</Project>
