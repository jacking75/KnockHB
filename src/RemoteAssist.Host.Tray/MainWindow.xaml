<Window x:Class="RemoteAssist.Host.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemoteAssist.Host.Tray"
        mc:Ignorable="d"
        Title="RemoteAssist — 대상자 지원" Height="730" Width="520" MinHeight="680" MinWidth="490"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Border x:Name="SessionBorder" BorderThickness="4" BorderBrush="#94A3B8" Padding="24">
        <StackPanel>
            <TextBlock Text="RemoteAssist" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="내가 승인한 지원자에게만 화면을 공유한다." Margin="0,8,0,16"/>
            <TextBlock x:Name="Status" Text="서비스 연결 확인 중이다." TextWrapping="Wrap" Height="48" AutomationProperties.AutomationId="HostStatus"/>
            <TextBlock Text="지원 ID" FontWeight="SemiBold"/>
            <TextBlock x:Name="Code" Text="—" FontSize="28" Margin="0,8,0,0" AutomationProperties.AutomationId="PairingCode"/>
            <TextBlock x:Name="PermissionNotice" Text="지원자가 이 지원 ID로 접속한다. 수동 지원은 연결할 때 권한을 선택한다." TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Button x:Name="StartButton" Content="새 지원 코드 만들기" Click="StartClicked" Height="38" IsEnabled="False" AutomationProperties.AutomationId="HostStart"/>
            <Button x:Name="StopButton" Content="즉시 종료" Click="StopClicked" Height="42" Margin="0,8,0,0" Background="#B91C1C" Foreground="White" FontWeight="Bold" AutomationProperties.AutomationId="HostStop"/>
            <TextBlock Text="승인한 세션의 채팅" Margin="0,12,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="ChatHistory" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ChatHistory"/>
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="ChatSend" AutomationProperties.AutomationId="ChatSend" DockPanel.Dock="Right" Content="보내기" IsEnabled="False" Click="ChatClicked" Padding="12,4"/>
                <TextBox x:Name="ChatText" AutomationProperties.AutomationId="ChatText" MaxLength="4096" IsEnabled="False"/>
            </DockPanel>
            <Button x:Name="FileSend" AutomationProperties.AutomationId="FileSend" Content="내가 선택한 파일 보내기" IsEnabled="False" Click="FileClicked" Margin="0,12,0,0" Height="32"/>
            <TextBlock x:Name="FileStatus" AutomationProperties.AutomationId="FileStatus" Text="파일 전송 대기" Margin="0,6,0,0"/>
            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Button x:Name="FileCancel" AutomationProperties.AutomationId="FileCancel" Content="파일 전송 취소" IsEnabled="False" Click="FileCancelClicked" Height="28"/>
        </StackPanel>
    </Border>
</Window>
